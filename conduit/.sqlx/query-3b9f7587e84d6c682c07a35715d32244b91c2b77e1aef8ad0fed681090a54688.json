{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, plant_id, dry_adc, wet_adc\n        FROM\n            sensor\n        WHERE\n            topic = $1\n        AND\n            sensor.archived_at IS NULL\n        AND\n            EXISTS (\n                SELECT\n                    1\n                FROM\n                    plant\n                WHERE\n                    plant.id = sensor.plant_id\n                AND\n                    plant.archived_at IS NULL\n            ) \n        ",
